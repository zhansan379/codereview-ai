# ============================================================================
# codereview-ai 环境变量示例
# Environment variable template for codereview-ai
#
# 用法：复制本文件为 .env 后按需修改（cp .env.example .env / 或 `copy .env.example .env`）。
# 每个变量都有中文与英文注解；常用项直接放开，不常用的保持注释，缺省即用内置默认。
#
# Usage: copy this file to .env and edit as needed. Common vars are left enabled;
# uncommon ones stay commented out and fall back to their built-in defaults.
#
# 环境变量统一前缀 CR_；真值用 true/false（大小写不敏感）。
# Env vars share the CR_ prefix; booleans use true/false (case-insensitive).
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# ① 必配密钥 · Required secrets（无默认值，缺失即 fail-fast 退出；务必换成你自己的）
#    No defaults — the app refuses to start without them. Replace with your own.
# ────────────────────────────────────────────────────────────────────────────

# 应用签名密钥 · App signing key（Session/登录态签名，长度随意但请够长）
CR_SECRET_KEY=<在这里填 secrets.token_urlsafe(48) 生成的值>

# Webhook 验签密钥 · Webhook HMAC signature secret（GitHub/GitLab 处填同一份）
CR_WEBHOOK_SECRET=<在这里填 secrets.token_urlsafe(48) 生成的值>

# 敏感信息加密密钥 · Fernet encryption key（32 字节 urlsafe-base64，必须用 Fernet 生成）
# 必须形如 xxxx=，不要用 secrets.token_urlsafe 顶替，否则启动校验会拒绝
CR_ENCRYPTION_KEY=<在这里填 Fernet.generate_key().decode() 的值>

# 后台登录口令 · Admin panel login password（单用户）
CR_ADMIN_PASSWORD=<在这里填 secrets.token_urlsafe(24) 生成的值>


# ────────────────────────────────────────────────────────────────────────────
# ② 审查行为 · Review behaviour（按需放开；diff/agentic 双模式共用同一切口）
#    Toggle per need. These split into diff vs agentic mode.
# ────────────────────────────────────────────────────────────────────────────

# MR/PR 轨审查总开关（默认关；项目也可在后台单独覆盖）。开 = 每个勾了 MR 的项目打开即审。
# Master switch for PR/MR-track review (default off; projects can override per-project).
# CR_MR_REVIEW_ENABLED=true

# 并发审查数（缺省 4）；进程运行中可在后台热改，不必重启。
# Reviews run concurrently (default 4); hot-tunable from the admin panel at runtime.
# CR_MAX_CONCURRENT_REVIEWS=4

# 单次模型调用超时（秒，缺省 60）
# Per-call LLM/HTTP request timeout in seconds (default 60).
# CR_REQUEST_TIMEOUT_SECONDS=60

# 静态分析融合（semgrep + ruff，缺省开；缺二进制自动降级，不影响主链路）
# Static analysis fusion — semgrep + ruff (default on; missing binaries degrade gracefully).
# CR_REVIEW_STATIC_ENABLED=true

# 静态分析工作目录（空 = 系统临时目录）；semgrep 本地规则目录（空 = registry 优先、内置包兜底）
# Temp workspace for static analysis (empty = OS tmp). Local semgrep rule dir (empty = registry first, bundled fallback).
# CR_STATIC_WORKSPACE_DIR=
# CR_SEMGREP_RULES_DIR=


# ────────────────────────────────────────────────────────────────────────────
# ③ agentic（全仓探索）审查 · Agentic whole-repo review
#    需同时满足：CR_AGENT_REVIEW_ENABLED=true（全局）+ 项目 review_strategy=agentic（后台勾选）
#    Requires BOTH the global switch below AND per-project strategy=agentic in the admin panel.
# ────────────────────────────────────────────────────────────────────────────

# 全局总开关（缺省关）。打开只是"允许"项目走 agentic，真正路由仍由每个项目决定。
# Global master switch (default off). Enabling only permits it; per-project strategy decides.
CR_AGENT_REVIEW_ENABLED=true

# 仓库 clone 缓存根目录（空 = 系统临时目录下 codereview-agent-repos）。盘够大建议显式指定。
# Bare-repo clone cache root (empty = <tmp>/codereview-agent-repos). Best set explicitly if you have the disk.
# CR_AGENT_CLONE_CACHE_DIR=

# 单组会话预算：最大轮数 / 最大时长秒数 / 提示 token 上限（缺省 20 / 300s / 80k）。
# 任一耗尽会进"收尾轮"逼模型交结论，不直接失败。
# Per-group session budget: max turns / max seconds / max prompt tokens (default 20 / 300s / 80k).
# Exhaustion triggers a grace round that forces a final submit, rather than failing outright.
CR_AGENT_MAX_ITERATIONS=300
CR_AGENT_MAX_TIME_SECONDS=600
# CR_AGENT_MAX_PROMPT_TOKENS=80000

# 单次审查内多文件组的并发上限（有界信号量，防打爆速率）
# Max concurrent file-groups inside one review (bounded semaphore).
# CR_AGENT_GROUP_CONCURRENCY=4

# 各阶段子开关（全默认开）：先规划 / 无行号意见重锚钉行 / 事实核查删错评 / 0-100 评分 / 原始对话逐条落库 / 增量轮未变更文件复用
# Per-stage toggles (all default on): plan-ahead / line re-anchoring / fact-check pruning / 0-100 scoring /
# per-call conversation capture / unchanged-file reuse across rounds.
# CR_AGENT_PLAN_ENABLED=true
# CR_AGENT_RELOCATION_ENABLED=true
# CR_AGENT_REVIEW_FILTER_ENABLED=true
# CR_AGENT_SCORING_ENABLED=true
# CR_AGENT_CONVERSATION_ENABLED=true
# CR_AGENT_REUSE_ENABLED=true


# ────────────────────────────────────────────────────────────────────────────
# ④ 主动补拉 · Active polling / sweep（把 webhook 漏掉或接入前就开着的 PR 捞回来）
#    Sweep for missed / pre-existing PRs (the webhook's safety net).
# ────────────────────────────────────────────────────────────────────────────

# 后台轮询开关 + 间隔秒（缺省关 / 3600s）。「手动补拉」按钮不受此开关限制，随时可用。
# Background poll toggle + interval seconds (default off / 3600). The manual "sweep" button always works regardless.
# CR_POLL_ENABLED=false
# CR_POLL_INTERVAL_SECONDS=3600


# ────────────────────────────────────────────────────────────────────────────
# ⑤ 推送通知 · Notifiers（钉钉 / 飞书 / 企业微信走后台配置密钥，不走 env）
#    Channel webhooks & secrets are configured in the admin panel, not here.
# ────────────────────────────────────────────────────────────────────────────

# 日报/推送调度开关 + 每日发送时刻（本地时区整点，缺省开 / 9 点）
# Daily report toggle + send hour in local time (default on / 9:00).
# CR_DAILY_REPORT_ENABLED=true
# CR_DAILY_REPORT_HOUR=9


# ────────────────────────────────────────────────────────────────────────────
# ⑥ 集成凭据 · Integration credentials
#    ⚠️ 这些是"env 覆盖"通道：显式配置后**压过**后台同名配置；不配就完全从后台读，可留空注释。
#    ⚠️ env OVERRIDES the admin panel for the same setting. If unset, the panel value is used — feel free to leave commented.
# ────────────────────────────────────────────────────────────────────────────

# 代码托管平台 token / 自托管地址（可选；env 设了以 env 为准，否则后台 forge_config）
# Forge token / self-hosted URL (optional; env wins, otherwise panel config is used).
# CR_GITHUB_TOKEN=
# CR_GITHUB_URL=https://api.github.com
# CR_GITLAB_TOKEN=
# CR_GITLAB_URL=

# LLM 模型名。⚠️ 一旦显式配置，**整个 DB 里的模型配置让位**（回退链也退成这个单模型）。
# ⚠️ 通过这里配置自选模型时，密钥/端点请填在 ⑦ 的 OPENAI_* 变量里，app 才会真正带上它们。
# Singular LLM model name. ⚠️ Setting this REPLACES all panel model config, including the fallback chain.
# ⚠️ When declaring a custom-vendor model here, put its key/endpoint in the OPENAI_* vars (⑦) so the app actually uses them.
# CR_LLM_MODEL=openai/ark-code-latest


# ────────────────────────────────────────────────────────────────────────────
# ⑦ 模型凭据 · Model credentials（LiteLLM 原生变量，无 CR_ 前缀 · Native LiteLLM env, no CR_ prefix）
#    想用"非标准出口"（自定义网关 / 火山方舟 / 各类代理）时，模型名填 openai/<实际名> 并配上这两个。
#    For a custom endpoint (gateway / Volcengine Ark / any proxy): use model `openai/<name>` plus these two.
# ────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=<你的模型厂商 API Key / 或 CR_LLM_API_KEY 的同类值>
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3


# ────────────────────────────────────────────────────────────────────────────
# ⑧ 运行环境 · Runtime（本地裸跑 / 多实例 / 调试才需要，一般不动）
#    Only needed for bare-metal run, multi-instance deploys, or debugging.
# ────────────────────────────────────────────────────────────────────────────

# 数据库连接串（缺省 sqlite:///./data/app.db；Docker 里 compose 已覆盖为 /app/data 下）
# Database URL (default local SQLite; compose overrides it for the container volume).
# CR_DATABASE_URL=sqlite:///./data/app.db

# 队列后端：simple= asyncio（单机，缺省）/ standard= arq + Redis（多实例，未打通的实验态）
# Queue backend: asyncio (single-node, default) vs arq + Redis (multi-instance, experimental/not wired).
# CR_QUEUE_BACKEND=asyncio
# CR_REDIS_URL=

# 管理台前端构建产物目录；为空按仓库根 frontend/dist 推算 —— 正常无需设置
# Admin UI dist dir; inferred from frontend/dist when empty. Leave unset in practice.
# CR_FRONTEND_DIST=

# 日志级别 · Log level
# CR_LOG_LEVEL=INFO

# 关闭 /docs 交互式 API 文档（0 关闭）· Turn off the interactive /docs (0 = off)
# CR_OPENAPI_ENABLED=true


############################################################################
# 说明 · Notes                                                        │ English
# ──────────────────────────────────────────────────────────────────────────
# · 后台里还能调到 / docs 之外的东西不走 env：worker 并发、clone 缓存清理等走
#   app_setting 表（函数/字段注释里已注明）。                                DB panel
# · CR_LLM_API_KEY / CR_LLM_BASE_URL / CR_BENCH_CACHE_DIR 等仅供 `python -m
#   codereview_ai.bench` 评测子命令专用，App 本体不读。                  bench-only
# · SEMGREP_SEND_METRICS 会被 App 内部强制置为 off，用户侧配不配都会被关掉。   forced off
# · Docker：docker-compose.yml 只透传 explicit 列出的变量，其余新增/修改 env
#   需同步加进 compose 的 environment 段，否则容器收不到。        docker pass-through
############################################################################